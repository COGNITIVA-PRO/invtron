{
  "rules": {
    ".read": "auth != null && auth.token.email_verified === true && root.child('Users').child(auth.uid).child('approved').val() === true",
    ".write": "auth != null && auth.token.email_verified === true && root.child('Users').child(auth.uid).child('approved').val() === true",

    "Users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true && ((!data.exists() && newData.child('approved').val() === false) || (data.exists() && newData.child('approved').val() === data.child('approved').val()))",
        ".validate": "newData.hasChildren(['email', 'name', 'phone', 'approved', 'ts'])",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "approved": {
          ".validate": "newData.isBoolean()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    },

    "Class": {
      "$Class_ID": {
        ".validate": "newData.hasChildren(['Class_ID', 'Class_name'])",
        "Class_ID": {
          ".validate": "newData.isString() && newData.val() === $Class_ID"
        },
        "Class_name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "$other": { ".validate": false }
      }
    },

    "Category": {
      "$Category_ID": {
        ".validate": "newData.hasChildren(['Category_ID', 'Category_name'])",
        "Category_ID": {
          ".validate": "newData.isString() && newData.val() === $Category_ID"
        },
        "Category_name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "$other": { ".validate": false }
      }
    },

    "Subcategory": {
      ".indexOn": ["Category_ID"],
      "$Subcategory_ID": {
        ".validate": "newData.hasChildren(['Subcategory_ID', 'Category_ID', 'Subcategory_name'])",
        "Subcategory_ID": {
          ".validate": "newData.isString() && newData.val() === $Subcategory_ID"
        },
        "Category_ID": {
          ".validate": "newData.isString() && root.child('Category').child(newData.val()).exists()"
        },
        "Subcategory_name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "$other": { ".validate": false }
      }
    },

    "Location": {
      "$Location_ID": {
        ".validate": "newData.hasChildren(['Location_ID', 'Location_name'])",
        "Location_ID": {
          ".validate": "newData.isString() && newData.val() === $Location_ID"
        },
        "Location_name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "$other": { ".validate": false }
      }
    },

    "Item": {
      ".indexOn": ["Subcategory_ID"],
      "$Item_ID": {
        ".validate": "newData.hasChildren(['Item_ID', 'Class_ID', 'Category_ID', 'Subcategory_ID', 'Location_ID', 'Part No', 'Item_name', 'Unit', 'Datasheet', 'Details', 'Picture'])",

        "Item_ID": {
          ".validate": "newData.isString() && newData.val() === $Item_ID"
        },
        "Class_ID": {
          ".validate": "newData.isString() && root.child('Class').child(newData.val()).exists()"
        },
        "Category_ID": {
          ".validate": "newData.isString() && root.child('Category').child(newData.val()).exists()"
        },
        "Subcategory_ID": {
          ".validate": "newData.isString() && root.child('Subcategory').child(newData.val()).exists()"
        },
        "Location_ID": {
          ".validate": "newData.isString() && root.child('Location').child(newData.val()).exists()"
        },
        "Part No": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 25"
        },
        "Item_name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "Unit": {
          ".validate": "newData.isString() && (newData.val() === 'Un' || newData.val() === 'cm' || newData.val() === 'g' || newData.val() === 'ml' || newData.val() === 'm' || newData.val() === 'Kg' || newData.val() === 'l')"
        },
        "VI-VR": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "VO-VF": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "VCEO-VDS": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "Gain": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "mA": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "Cap": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "Watts": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "Ohms": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "Tol%": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === '' || newData.val() === '1%' || newData.val() === '5%' || newData.val() === '10%'))"
        },
        "MHz": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "Pins": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "Datasheet": {
          ".validate": "newData.isString() && newData.val().beginsWith('http')"
        },
        "Details": {
          ".validate": "newData.isString() && newData.val().beginsWith('http')"
        },
        "Picture": {
          ".validate": "newData.isString() && newData.val().beginsWith('http')"
        },
        "$other": { ".validate": false }
      }
    },

    "Inventory": {
      ".indexOn": ["Item_ID"],
      "$Inventory_ID": {
        ".validate": "newData.hasChildren(['Inventory_ID', 'Item_ID', 'Quantity'])",
        "Inventory_ID": {
          ".validate": "newData.isString() && newData.val() === $Inventory_ID"
        },
        "Item_ID": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('Item').child(newData.val()).exists()"
        },
        "Quantity": {
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    },

    "History": {
      "$History_ID": {
        ".validate": "newData.hasChildren(['History_ID', 'Item_ID', 'Action', 'Details', 'Quantity'])",
        "History_ID": {
          ".validate": "newData.isString() && newData.val() === $History_ID"
        },
        "Item_ID": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('Item').child(newData.val()).exists()"
        },
        "Action": {
          ".validate": "newData.isString() && (newData.val() === 'Buy' || newData.val() === 'Prt' || newData.val() === 'Mke' || newData.val() === 'Use' || newData.val() === 'Rec' || newData.val() === 'Dam' || newData.val() === 'Def' || newData.val() === 'Dis')"
        },
        "Details": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "Quantity": {
          ".validate": "newData.isNumber()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
